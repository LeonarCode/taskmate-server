# Copy to .env and fill in. Never commit .env.

# PostgreSQL. host.docker.internal = the PostgreSQL on your own machine (use localhost when running without Docker)
DOCKER_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@host.docker.internal:5432/taskmate

# Signs the JWTs: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# OAuth client ID that Google ID tokens must be issued for
GOOGLE_CLIENT_ID=

# Optional: JWT algorithm and lifetime (defaults: HS256, 10080 minutes = 7 days)
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: forgot-password emails. Leave SMTP_HOST empty to only print the code in the log (development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: cloudinary://API_KEY:API_SECRET@CLOUD_NAME. Leave empty to store profile photos in the database
CLOUDINARY_URL=
